APP_NAME=main-sv-test
PORT=3100
LOG_LEVEL=silent
LOG_PRETTY=false
CORS_ORIGINS=*
JWT_SECRET=test-only-secret-value

# The users suite runs against real SQL and skips itself without this.
# Point it at a throwaway database — the suite TRUNCATEs the users table.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/main_sv_test
DB_POOL_MAX=3
