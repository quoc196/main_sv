{
  "name": "main-sv",
  "version": "1.0.0",
  "description": "Base backend Node.js (Express 5, ESM) with development / staging / production environments",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --watch src/server.js",
    "start:dev": "cross-env NODE_ENV=development node src/server.js",
    "start:staging": "cross-env NODE_ENV=staging node src/server.js",
    "start:prod": "cross-env NODE_ENV=production node src/server.js",
    "start": "node src/server.js",
    "test": "cross-env NODE_ENV=test node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "env:check": "node -e \"import('./src/config/index.js').then(m=>console.log(JSON.stringify(m.default,null,2)))\"",
    "db:migrate": "node scripts/migrate.js up",
    "db:rollback": "node scripts/migrate.js down",
    "db:new": "node-pg-migrate create -j js"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  }
}
