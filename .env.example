# Copy to .env.development / .env.staging / .env.production and fill in.
# Real process env (systemd, PM2, CI, container) always overrides these files.

APP_NAME=main-sv
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
LOG_PRETTY=false

# Comma-separated list, or * to allow every origin. With *, credentialed
# (cookie) requests are disabled, and NODE_ENV=production refuses to boot.
CORS_ORIGINS=*

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# App connects through DATABASE_URL. If your provider puts a transaction-mode
# pooler in front (Neon, Supabase, RDS Proxy), use the POOLED string here and the
# direct string in DATABASE_URL_UNPOOLED — migrations need the direct one.
# DATABASE_URL=postgresql://user:pass@localhost:5432/main_sv
# DATABASE_URL_UNPOOLED=
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECT_TIMEOUT_MS=10000

# REDIS_URL=redis://localhost:6379

# Required in every environment. Minimum 16 characters.
# Access tokens are short-lived; the refresh token keeps the session going.
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

SHUTDOWN_TIMEOUT_MS=10000
