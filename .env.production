APP_NAME=main-sv
PORT=3000
HOST=0.0.0.0
API_PREFIX=/api/v1

LOG_LEVEL=info
LOG_PRETTY=false

CORS_ORIGINS=https://example.com

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Leave secrets empty here and inject them from the deploy environment
# (systemd EnvironmentFile, PM2 ecosystem, CI secret store, ...).
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
DB_POOL_MAX=5
# REDIS_URL=

JWT_SECRET=
JWT_EXPIRES_IN=1d

SHUTDOWN_TIMEOUT_MS=15000
